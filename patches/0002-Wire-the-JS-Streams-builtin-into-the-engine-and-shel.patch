diff --git a/js/moz.configure b/js/moz.configure
index 765c1de95f38..a363235983ab 100644
--- a/js/moz.configure
+++ b/js/moz.configure
@@ -233,6 +233,24 @@ set_config(
 )
 
 
+# Enable JS Streams
+# ===================================================
+option(
+    "--enable-js-streams",
+    default=False,
+    help="Enable non-default JS Streams implementation",
+)
+
+
+@depends("--enable-js-streams")
+def enable_js_streams(value):
+    if value:
+        return True
+
+
+set_config("MOZ_JS_STREAMS", enable_js_streams)
+set_define("MOZ_JS_STREAMS", enable_js_streams)
+
 # JIT support
 # =======================================================
 @depends(target, "--enable-portable-baseline-interp")
