From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: sunnymar <sunnym@gmail.com>
Date: Sat, 17 Oct 2026 20:14:48 +0300
Subject: [PATCH] jit-test harness: fail interrupted runs and mismatched
 expected errors

An interrupted jit-test run and an expected error that does not match are
failures, with unit tests in js/src/tests/lib/test_jittests.py.

Source commits in YurtOS/firefox (yurt dff5cf534448):
  b6bf683e9267 test: reject Boolean statuses for expected jit-test errors
    (only js/src/tests/lib)
  0c38bedd68b3 fix: count mismatched expected jit-test errors as failures
    (only js/src/tests/lib)
  f1715f0fe944 test: reject successful verdicts for interrupted jit-test runs
    (only js/src/tests/lib)
  04031a147589 fix: fail interrupted jit-test runs
    (only js/src/tests/lib)
---
 js/src/tests/lib/jittests.py      |  4 +--
 js/src/tests/lib/test_jittests.py | 44 +++++++++++++++++++++++++++++++
 2 files changed, 46 insertions(+), 2 deletions(-)
 create mode 100644 js/src/tests/lib/test_jittests.py

diff --git a/js/src/tests/lib/jittests.py b/js/src/tests/lib/jittests.py
index 73ba27976e13..265c825ac7c6 100755
--- a/js/src/tests/lib/jittests.py
+++ b/js/src/tests/lib/jittests.py
@@ -487,7 +487,7 @@ def check_output(out, err, rc, timed_out, test, options):
         if rc != 3:
             return OutputStatus.FAILED
 
-        return test.expect_error in err
+        return OutputStatus.OK if test.expect_error in err else OutputStatus.FAILED
 
     for line in out.split("\n"):
         if line.startswith("Trace stats check failed"):
@@ -678,7 +678,7 @@ def print_test_summary(num_tests, failures, complete, slow_tests, doing, options
         if not any:
             print("None")
 
-    return not failures
+    return complete and not failures
 
 
 def create_progressbar(num_tests, options):
diff --git a/js/src/tests/lib/test_jittests.py b/js/src/tests/lib/test_jittests.py
new file mode 100644
index 000000000000..3e2240b4bf16
--- /dev/null
+++ b/js/src/tests/lib/test_jittests.py
@@ -0,0 +1,44 @@
+# This Source Code Form is subject to the terms of the Mozilla Public
+# License, v. 2.0. If a copy of the MPL was not distributed with this
+# file, You can obtain one at http://mozilla.org/MPL/2.0/.
+
+import contextlib
+import io
+import unittest
+from types import SimpleNamespace
+
+from .jittests import JitTest, OutputStatus, check_output, print_test_summary
+
+
+class ExpectedErrorStatusTests(unittest.TestCase):
+    def test_interrupted_run_is_unsuccessful(self):
+        options = SimpleNamespace(format="automation", show_slow=False)
+        with contextlib.redirect_stdout(io.StringIO()):
+            ok = print_test_summary(10, [], False, [], "after one test", options)
+        self.assertFalse(ok)
+
+    def test_complete_run_is_successful(self):
+        options = SimpleNamespace(format="automation", show_slow=False)
+        with contextlib.redirect_stdout(io.StringIO()):
+            ok = print_test_summary(10, [], True, [], "after all tests", options)
+        self.assertTrue(ok)
+
+    def test_wrong_exception_is_a_failure_status(self):
+        test = JitTest("expected-error.js")
+        test.expect_error = "ReferenceError"
+        status = check_output(
+            "", "TypeError: wrong exception", 3, False, test, SimpleNamespace()
+        )
+        self.assertIs(status, OutputStatus.FAILED)
+
+    def test_matching_exception_is_an_ok_status(self):
+        test = JitTest("expected-error.js")
+        test.expect_error = "ReferenceError"
+        status = check_output(
+            "", "ReferenceError: expected exception", 3, False, test, SimpleNamespace()
+        )
+        self.assertIs(status, OutputStatus.OK)
+
+
+if __name__ == "__main__":
+    unittest.main()
