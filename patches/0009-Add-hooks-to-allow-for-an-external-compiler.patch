+]
+
+DEFINES["EXPORT_JS_API"] = True
+DEFINES["MOZ_HAS_MOZGLUE"] = True
+DEFINES["JS_SHELL_LIBRARY"] = True
+
+LOCAL_INCLUDES += [
+    "!../..",
+    "../..",
+    "/third_party/wizer",
+]
+
+rust_profile = "debug" if CONFIG["MOZ_DEBUG_RUST"] else "release"
